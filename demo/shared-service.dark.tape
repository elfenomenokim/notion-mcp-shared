Output demo/shared-service.dark.gif
Set Shell zsh
Set FontSize 18
Set Width 1200
Set Height 520
Set Theme "Catppuccin Mocha"
Type "printf 'Notion MCP shared service\\n\\n'"
Enter
Sleep 500ms
Type "printf 'Client sessions     Server processes\\n'"
Enter
Type "printf 'Claude Code     ─┐\\nCodex           ─┤\\nPi              ─┼──> 127.0.0.1:58983/mcp\\nAntigravity     ─┤          │\\nKimi Code       ─┘          v\\n                    one Node.js process\\n\\n'"
Enter
Type "printf 'Authorization: Bearer <local service token>\\nNotion-Token: <per-request account token>\\n'"
Enter
Sleep 2s
