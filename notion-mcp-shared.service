[Unit]
Description=Shared Notion MCP loopback service
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NOTION_MCP_SHARED_PORT=__PORT__
Environment=NOTION_MCP_SHARED_RUNTIME=__RUNTIME__
Environment=NOTION_MCP_SHARED_SECRET=__SECRET__
ExecStart=%h/.local/bin/__NAME__
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
